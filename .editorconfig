root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# swift-format's default indentation, which .swift-format keeps.
[*.swift]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
